---
import '../styles/global.css';
import { SiteHeader } from '../components/SiteHeader';
import { withBase } from '../utils/withBase';

interface Props {
  title: string;
  description?: string;
  socialImage?: string | null;
  immersive?: boolean;
}
const {
  title,
  description = '복잡한 제품의 데이터와 상태를 사용자가 판단하고 실행할 수 있는 흐름으로 설계하는 프론트엔드 엔지니어 김민찬',
  socialImage = withBase('og.png'),
  immersive = false
} = Astro.props;
const siteUrl = import.meta.env.SITE;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImageUrl = socialImage ? new URL(socialImage, siteUrl).href : undefined;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="김민찬 Portfolio" />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta property="og:image:width" content="1200" />}
    {socialImageUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
  </head>
  <body>
    {!immersive && <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-[var(--paper)] focus:px-4 focus:py-3">
      본문으로 건너뛰기
    </a>}
    {!immersive && <SiteHeader
      homeHref={withBase()}
      workHref={withBase('case-studies/')}
      aboutHref={withBase('about/')}
      engineeringHref={withBase('engineering/')}
      contactHref={withBase('contact/')}
      currentPath={Astro.url.pathname}
    />}
    {immersive
      ? <div id="main-content" class="min-h-screen"><slot /></div>
      : <main id="main-content" class="mx-auto min-h-[75vh] max-w-6xl px-5 py-12 sm:px-8 sm:py-20"><slot /></main>}
    {!immersive && <footer class="border-t border-black/20">
      <div class="mx-auto max-w-6xl px-5 py-8 text-xs text-black/55 sm:px-8">
        <p>© {new Date().getFullYear()} 김민찬</p>
      </div>
    </footer>}
  </body>
</html>
