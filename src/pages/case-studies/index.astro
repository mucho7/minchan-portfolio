---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';

const caseStudies = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Case Studies | 김민찬 포트폴리오"
  description="시뮬레이션 재생, 대용량 시계열, Agent UI 공통화, Web IDE, MLOps 워크플로우를 다룬 프론트엔드 Case Study"
>
  <header class="border-b border-black/20 pb-10 sm:pb-14">
    <h1 class="text-4xl font-semibold tracking-[-0.04em] sm:text-6xl">Work</h1>
  </header>
  <section class="border-b border-black/25">
    {caseStudies.map((study) => (
      <CaseStudyCard study={study} />
    ))}
  </section>
</BaseLayout>
