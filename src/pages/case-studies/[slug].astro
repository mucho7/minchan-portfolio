---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/withBase';

export async function getStaticPaths() {
  const studies = await getCollection('case-studies');
  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study }
  }));
}

interface Props {
  study: CollectionEntry<'case-studies'>;
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<BaseLayout
  title={`${study.data.title} | Case Study`}
  description={study.data.summary}
  socialImage={null}
>
  <article>
    <a href={withBase('case-studies/')} class="mb-10 inline-block text-sm text-black/55 underline">← 모든 작업</a>
    <header class="border-b border-black/25 pb-12 sm:pb-16">
      <div class="grid gap-8 sm:grid-cols-[1fr_3fr]">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-[var(--accent)]">Case Study</p>
          <p class="mt-4 text-xs font-medium leading-5 text-black/60">{study.data.company}</p>
          <p class="mt-1 font-mono text-xs leading-5 text-black/45">{study.data.period}</p>
        </div>
        <div>
          <h1 class="max-w-4xl text-4xl font-semibold leading-[1.06] tracking-[-0.05em] sm:text-5xl">{study.data.title}</h1>
          <p class="mt-6 max-w-3xl whitespace-pre-line text-base leading-8 text-black/60 sm:text-lg">{study.data.summary}</p>
          <p class="mt-6 text-sm text-black/50">{study.data.role}</p>
        </div>
      </div>
      <div class="mt-10 grid gap-6 border-t border-black/20 pt-6 sm:grid-cols-2">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-black/40">Evidence</p>
          <ul class="mt-3 space-y-2">
            {study.data.metrics.map((metric) => <li class="text-sm font-medium text-[var(--accent)]">{metric}</li>)}
          </ul>
        </div>
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-black/40">Technology</p>
          <p class="mt-3 text-sm leading-6 text-black/55">{study.data.skills.join(' · ')}</p>
        </div>
      </div>
    </header>
    <div class="case-study-body mx-auto max-w-3xl py-14 sm:py-20">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  import { renderMermaidDiagrams } from '../../scripts/render-mermaid';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderMermaidDiagrams, { once: true });
  } else {
    renderMermaidDiagrams();
  }
</script>
