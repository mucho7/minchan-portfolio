---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const studies = await getCollection('case-studies');
  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study }
  }));
}

interface Props {
  study: CollectionEntry<'case-studies'>;
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<BaseLayout
  title={`${study.data.title} | Case Study`}
  description={study.data.summary}
  socialImage={null}
>
  <article>
    <header class="mx-auto max-w-3xl">
      <h1 class="text-4xl font-semibold leading-[1.06] tracking-[-0.04em] sm:text-5xl">{study.data.title}</h1>
      <p class="mt-6 whitespace-pre-line text-base leading-8 text-black/60 sm:text-lg">{study.data.summary}</p>
    </header>
    <div class="case-study-body mx-auto max-w-3xl pb-14 sm:pb-20">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  import { renderMermaidDiagrams } from '../../scripts/render-mermaid';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderMermaidDiagrams, { once: true });
  } else {
    renderMermaidDiagrams();
  }
</script>
