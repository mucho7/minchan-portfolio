---
import BaseLayout from '../layouts/BaseLayout.astro';

const channels = [
  { label: 'Email', value: 'ydjm1994@gmail.com', href: 'mailto:ydjm1994@gmail.com' },
  { label: 'GitHub', value: 'github.com/mucho7', href: 'https://github.com/mucho7' },
  { label: 'Velog', value: 'velog.io/@kimjih94/posts', href: 'https://velog.io/@kimjih94/posts' }
];
---

<BaseLayout
  title="Contact | 김민찬 Frontend Engineer"
  description="프론트엔드 엔지니어 김민찬의 이메일, GitHub, 기술 블로그"
>
  <header class="border-b border-black/25 pb-12 sm:pb-16">
    <h1 class="text-4xl font-semibold tracking-[-0.04em] sm:text-6xl">Contact</h1>
  </header>

  <section class="grid gap-3 py-10 md:grid-cols-3 sm:py-14" aria-label="연락 채널">
    {channels.map((channel) => (
      <a
        href={channel.href}
        target={channel.href.startsWith('http') ? '_blank' : undefined}
        rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        class="group min-w-0 rounded-2xl bg-[var(--surface)] p-6 transition-colors hover:bg-[var(--nav-surface)] focus-visible:outline-offset-2 sm:min-h-44"
      >
        <span class="block text-sm font-medium text-[var(--ink-muted)]">{channel.label}</span>
        <span class="mt-8 block break-words text-base font-semibold tracking-[-0.02em] group-hover:underline lg:text-lg">{channel.value}</span>
      </a>
    ))}
  </section>
</BaseLayout>
