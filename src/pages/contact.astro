---
import BaseLayout from '../layouts/BaseLayout.astro';

const channels = [
  { label: 'Email', value: 'ydjm1994@gmail.com', href: 'mailto:ydjm1994@gmail.com' },
  { label: 'GitHub', value: 'github.com/mucho7', href: 'https://github.com/mucho7' },
  { label: 'Velog', value: 'velog.io/@kimjih94/posts', href: 'https://velog.io/@kimjih94/posts' }
];
---

<BaseLayout
  title="Contact | 김민찬 Frontend Engineer"
  description="프론트엔드 엔지니어 김민찬의 이메일, GitHub, 기술 블로그"
>
  <header class="grid gap-6 border-b border-black/25 pb-12 sm:grid-cols-[1fr_2fr] sm:pb-16">
    <p class="font-mono text-xs uppercase tracking-[0.16em] text-black/45">Contact</p>
    <div>
      <h1 class="text-4xl font-semibold tracking-[-0.05em] sm:text-6xl">제품과 기술에 관한<br />대화를 기다립니다.</h1>
      <p class="mt-6 max-w-xl text-base leading-8 text-black/60">
        복잡한 도메인 UI, 대용량 데이터 탐색, AI 제품 개발과 협업 경험이 궁금하다면 편하게 연락해 주세요.
      </p>
    </div>
  </header>

  <section class="border-b border-black/25" aria-label="연락 채널">
    {channels.map((channel, index) => (
      <a
        href={channel.href}
        target={channel.href.startsWith('http') ? '_blank' : undefined}
        rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        class="group grid gap-2 border-t border-black/25 py-7 first:border-t-0 sm:grid-cols-[5rem_1fr_auto] sm:items-center sm:py-9"
      >
        <span class="font-mono text-xs text-black/40">0{index + 1}</span>
        <span>
          <span class="block text-xs uppercase tracking-[0.12em] text-black/45">{channel.label}</span>
          <span class="mt-2 block text-xl font-semibold tracking-[-0.03em] group-hover:underline sm:text-2xl">{channel.value}</span>
        </span>
        <span aria-hidden="true" class="text-xl text-black/35 transition-transform group-hover:translate-x-1">↗</span>
      </a>
    ))}
  </section>

  <p class="py-10 text-sm leading-6 text-black/50">가장 빠른 연락 채널은 이메일입니다.</p>
</BaseLayout>
