---
import BaseLayout from '../layouts/BaseLayout.astro';
import { techContext } from '../data/tech-context';

const experience = [
  {
    company: 'AHHA Labs',
    period: '2024.11 — Present',
    scope: '제조 AI MLOps · AI Agent UI · 자동화 공정 관제',
    highlights: [
      'SSE 채팅과 Workflow Builder를 포함한 AI Agent MVP를 FE 1인으로 4주 내 완성',
      '유일한 FE이자 Scrum Master로 1·2차 제조 관제 PoC 구현과 협업 조율, 프로젝트 수주에 기여',
      '5천만 건 이상 시계열 데이터의 다운샘플링·상태 구독·렌더링 구조 개선',
      'Codex Skill과 승인 기반 ClickUp 등록으로 태스크 작성·계획 수립을 약 1시간에서 10–13분으로 단축'
    ]
  },
  {
    company: 'Tmax Cloud',
    period: '2023.08 — 2024.11',
    scope: '슈퍼앱 내부 Code Editor · 클라우드 플랫폼 관리 콘솔',
    highlights: [
      'GAIA PX Web IDE 프론트엔드를 단독 개발하고 파일 탐색·자동완성·오류 표시·실행·로컬 저장 흐름 구현',
      '상태 구독과 컴포넌트 경계를 개선해 주요 갱신 시 렌더링을 20–30회에서 2회로 축소',
      '보안 그룹·로드밸런서·네트워크·DB 세션의 관계와 API 제약을 반영한 IaaS 관리 화면 구현'
    ]
  }
];
---

<BaseLayout
  title="Experience | 김민찬 Frontend Engineer"
  description="AI·제조·클라우드 제품에서 복잡한 데이터와 상태를 다뤄온 프론트엔드 엔지니어 김민찬의 경력과 작업 방식"
>
  <header class="grid gap-6 border-b border-black/25 pb-12 sm:grid-cols-[1fr_2fr] sm:pb-16">
    <p class="font-mono text-xs uppercase tracking-[0.16em] text-black/45">Experience & approach</p>
    <div>
      <h1 class="text-4xl font-semibold tracking-[-0.05em] sm:text-6xl">복잡한 현장을<br />제품의 언어로 바꿉니다.</h1>
      <p class="mt-6 max-w-2xl text-base leading-8 text-black/60">
        AI·제조·클라우드 제품의 초기 개발부터 성능 개선과 업무 자동화까지 경험했습니다.
        화면 구현에 머물지 않고 문제 정의, 기술 선택, 협업과 현장 검증을 연결합니다.
      </p>
    </div>
  </header>

  <section class="border-b border-black/25 py-14 sm:py-20" aria-labelledby="experience-heading">
    <div class="grid gap-8 sm:grid-cols-[1fr_2fr]">
      <h2 id="experience-heading" class="font-mono text-xs uppercase tracking-[0.16em] text-black/45">Career</h2>
      <div class="space-y-14">
        {experience.map((item) => (
          <article>
            <div class="flex flex-col gap-2 border-b border-black/20 pb-5 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <h3 class="text-2xl font-semibold tracking-[-0.03em]">{item.company}</h3>
                <p class="mt-1 text-sm text-black/50">{item.scope}</p>
              </div>
              <p class="font-mono text-xs text-black/45">{item.period}</p>
            </div>
            <ul class="mt-5 space-y-3 text-sm leading-6 text-black/65">
              {item.highlights.map((highlight) => <li class="relative pl-5 before:absolute before:left-0 before:content-['—']">{highlight}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="grid gap-8 border-b border-black/25 py-14 sm:grid-cols-[1fr_2fr] sm:py-20">
    <h2 class="font-mono text-xs uppercase tracking-[0.16em] text-black/45">How I work with AI</h2>
    <div class="space-y-6">
      <h3 class="max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.04em]">AI 제품을 만든 경험과<br />AI로 개발하는 방식을 구분합니다.</h3>
      <p class="max-w-2xl leading-7 text-black/65">
        Agent 제품에서는 입력·실행·결과의 사용자 흐름을 설계합니다. 개발 도구로 Codex를 사용할 때는 프로젝트 맥락과 변경 제약을 먼저 제공하고, 생성된 diff를 직접 리뷰합니다.
      </p>
      <ol class="grid gap-px bg-black/20 sm:grid-cols-4">
        {['맥락·제약 제공', '생성 diff 리뷰', '타입·테스트 확인', '브라우저 동작 검증'].map((step, index) => (
          <li class="bg-[var(--paper)] p-5">
            <span class="font-mono text-xs text-[var(--accent)]">0{index + 1}</span>
            <p class="mt-4 text-sm font-medium">{step}</p>
          </li>
        ))}
      </ol>
      <p class="max-w-2xl text-sm leading-6 text-black/55">
        제안이 상태 소유권을 흐리거나 추상화를 과도하게 만들면 채택하지 않고 직접 경계를 다시 설계합니다.
      </p>
    </div>
  </section>

  <section class="grid gap-8 border-b border-black/25 py-14 sm:grid-cols-[1fr_2fr] sm:py-20">
    <h2 class="font-mono text-xs uppercase tracking-[0.16em] text-black/45">Technology in context</h2>
    <dl class="divide-y divide-black/20 border-y border-black/20">
      {techContext.map(({ name, context }) => (
        <div class="grid gap-2 py-4 sm:grid-cols-[12rem_1fr]">
          <dt class="font-medium text-[var(--accent)]">{name}</dt>
          <dd class="text-sm leading-6 text-black/60">{context}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="grid gap-8 py-14 sm:grid-cols-[1fr_2fr] sm:py-20">
    <h2 class="font-mono text-xs uppercase tracking-[0.16em] text-black/45">Education & contribution</h2>
    <div class="grid gap-8 sm:grid-cols-2">
      <div>
        <h3 class="text-lg font-semibold">Education</h3>
        <p class="mt-4 leading-7 text-black/65">경북대학교 전자공학부<br />SSAFY · 웹 개발</p>
      </div>
      <div>
        <h3 class="text-lg font-semibold">Open source</h3>
        <p class="mt-4 leading-7 text-black/65">
          toss/react-simplikit 공개 초기 이슈 제보<br />
          재현 조건과 개선 방향 논의 ·
          <a href="https://github.com/toss/react-simplikit/issues/172" target="_blank" rel="noopener noreferrer" class="text-[var(--accent)] underline">Issue #172</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
