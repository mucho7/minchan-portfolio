---
import { getCollection } from 'astro:content';
import PortfolioExperience from '../components/PortfolioExperience';
import BaseLayout from '../layouts/BaseLayout.astro';
import { toProjectViewModel } from '../mappers/case-study';
import { CAREER_PROJECT_SLUGS } from '../types/portfolio';
import { withBase } from '../utils/withBase';

const allCaseStudies = await getCollection('case-studies');
const projects = CAREER_PROJECT_SLUGS
  .map((id) => allCaseStudies.find((study) => study.id === id))
  .filter((study): study is (typeof allCaseStudies)[number] => Boolean(study))
  .map((study) => toProjectViewModel(study, (slug) => withBase(`case-studies/${slug}/`)));
---

<BaseLayout
  title="김민찬 | Frontend Engineer"
  description="산업용 데이터와 복잡한 상태를 사용자가 판단하고 실행할 수 있는 제품 흐름으로 만드는 프론트엔드 엔지니어 김민찬"
  immersive
>
  <PortfolioExperience
    client:load
    projects={projects}
    homeHref={withBase()}
    aboutHref={withBase('about/')}
    workHref={withBase('case-studies/')}
    contactHref={withBase('contact/')}
    portfolioHref={withBase('case-studies/portfolio-engineering/')}
  />
</BaseLayout>
