---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { withBase } from '../utils/withBase';

const caseStudies = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const evidence = [
  { value: '4주', label: 'AI Agent MVP\nFrontend 단독 개발' },
  { value: '50M+', label: '시계열 데이터\n탐색 경험' },
  { value: '20–30 → 2', label: 'Web IDE 주요 동작\n렌더링 횟수' }
];
---

<BaseLayout title="김민찬 | Frontend Engineer" description="AI Agent, 스마트팩토리, 비전 검사와 클라우드 제품의 복잡한 흐름을 설계하고 구현하는 프론트엔드 엔지니어 김민찬">
  <section class="grid gap-10 border-b border-black/25 pb-16 sm:pb-24 lg:grid-cols-[1fr_18rem] lg:gap-20">
    <div>
      <p class="mb-7 font-mono text-xs uppercase tracking-[0.16em] text-black/45">Frontend Engineer · Seoul</p>
      <h1 class="max-w-4xl text-[clamp(2.8rem,7vw,6.5rem)] font-semibold leading-[0.97] tracking-[-0.065em]">복잡한 제품을<br />명료한 흐름으로.</h1>
      <p class="mt-8 max-w-2xl text-base leading-7 text-black/65 sm:text-lg sm:leading-8">
        AI Agent, 스마트팩토리, 비전 검사, 클라우드·Web IDE를 개발해왔습니다.
        단독 FE부터 FE Lead·Scrum Master까지 맡아 문제 정의, 기술 선택, 구현과 현장 검증을 연결합니다.
      </p>
    </div>
    <aside class="self-end border-t border-black/25 pt-4 text-sm leading-6 text-black/60 lg:border-l lg:border-t-0 lg:pl-6">
      <p class="font-medium text-black">Currently</p>
      <p class="mt-1">AHHA Labs<br />Frontend Engineer<br />2024.11 — Present</p>
      <a href={withBase('about/')} class="mt-5 inline-block text-[#315c4c] underline">경력 전체 보기</a>
    </aside>
  </section>

  <section class="grid border-b border-black/25 py-12 sm:grid-cols-3 sm:py-16" aria-label="대표 성과">
    {evidence.map(({ value, label }, index) => (
      <div class:list={['py-5 sm:py-0', index > 0 && 'border-t border-black/20 sm:border-l sm:border-t-0 sm:pl-8']}>
        <p class="text-3xl font-semibold tracking-[-0.05em] sm:text-4xl">{value}</p>
        <p class="mt-3 whitespace-pre-line text-sm leading-5 text-black/50">{label}</p>
      </div>
    ))}
  </section>

  <section class="pt-16 sm:pt-24">
    <div class="mb-8 flex items-end justify-between">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-black/40">Selected work</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-[-0.04em]">판단과 실행을 바꾼 작업</h2>
      </div>
      <a href={withBase('case-studies/')} class="hidden text-sm underline sm:block">모든 작업 보기</a>
    </div>
    <div class="border-b border-black/25">
      {caseStudies.map((study, index) => <CaseStudyCard study={study} index={index} />)}
    </div>
  </section>

  <section class="grid gap-8 py-20 sm:grid-cols-2 sm:py-28">
    <h2 class="max-w-lg text-3xl font-semibold leading-tight tracking-[-0.04em] sm:text-4xl">기술보다 먼저 데이터의 특성과 사용자의 행동을 봅니다.</h2>
    <div class="max-w-xl space-y-5 text-sm leading-7 text-black/65 sm:text-base">
      <p>WebSocket, SSE, polling, 전역 상태 관리, Canvas는 목적이 아니라 선택지입니다. 필요한 응답성과 시스템 비용, 사용자가 실제로 수행하는 행동을 기준으로 고릅니다.</p>
      <p>성능 문제도 단순한 최적화 API보다 상태의 소유권, 구독 범위와 렌더링 경계를 먼저 확인합니다.</p>
      <div class="flex gap-6 pt-2 text-sm text-[#315c4c]">
        <a href={withBase('about/')} class="underline">소개와 경력</a>
        <a href={withBase('contact/')} class="underline">연락하기</a>
      </div>
    </div>
  </section>
</BaseLayout>
