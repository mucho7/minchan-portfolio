---
interface Props {
  chart: string;
  caption?: string;
}

const { chart, caption } = Astro.props;
---

<figure class="my-8 space-y-3">
  {
    caption && (
      <figcaption class="text-center text-sm text-black/50">{caption}</figcaption>
    )
  }
  <div class="overflow-x-auto border-y border-[var(--diagram-border)]/30 bg-[var(--diagram-surface)] p-4 sm:p-6">
    <pre class="mermaid">{chart.trim()}</pre>
  </div>
</figure>
