---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/withBase';

interface Props {
  study: CollectionEntry<'case-studies'>;
  showPreview?: boolean;
  variant?: 'grid' | 'list';
}
const { study, showPreview = false, variant = 'grid' } = Astro.props;
const { title, company, summary, period, role, skills, metrics, preview } = study.data;
const href = withBase(`case-studies/${study.id}/`);
const distinctiveSkills = skills.filter((skill) => !['React', 'TypeScript'].includes(skill));
---

<a href={href} class="group block border-t border-black/25 py-7 transition sm:py-9">
  <article class="grid gap-5 sm:grid-cols-[5rem_1fr] lg:grid-cols-[7rem_1fr_15rem]">
    <p class="text-xs leading-5 text-black/45"><span class="font-medium text-black/60">{company}</span><br />{period}</p>
    <div>
      <p class="mb-2 text-xs text-black/50">{role}</p>
      <h3 class:list={['max-w-2xl font-semibold leading-tight tracking-[-0.035em] group-hover:underline', variant === 'list' ? 'text-2xl sm:text-3xl' : 'text-xl sm:text-2xl']}>
        {title}
      </h3>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-black/60">{summary}</p>
      {showPreview && preview && (
        <p class="mt-5 max-w-2xl border-l border-black/25 pl-4 text-sm leading-6 text-black/65">
          <span class="font-medium text-black">Decision.</span> {preview.decision}
        </p>
      )}
    </div>
    <div class="lg:text-right">
      <p class="text-sm font-medium text-[#315c4c]">{metrics[0]}</p>
      {distinctiveSkills.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5 lg:justify-end" aria-label="프로젝트 특화 기술">
          {distinctiveSkills.slice(0, 5).map((skill) => (
            <li class="inline-flex min-h-7 items-center rounded-md border border-[var(--line)] bg-[var(--surface)] px-2.5 py-1 text-xs font-medium leading-none text-[var(--ink-secondary)]">
              {skill}
            </li>
          ))}
        </ul>
      )}
    </div>
  </article>
</a>
