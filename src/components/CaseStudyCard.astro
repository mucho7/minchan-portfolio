---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/withBase';

interface Props {
  study: CollectionEntry<'case-studies'>;
}
const { study } = Astro.props;
const { title, skills, metrics } = study.data;
const href = withBase(`case-studies/${study.id}/`);
const distinctiveSkills = skills.filter((skill) => !['React', 'TypeScript'].includes(skill));
const badges = [metrics[0], ...distinctiveSkills].slice(0, 5);
---

<a href={href} class="group block border-t border-black/20 py-9 transition-colors hover:border-black/45 sm:py-12">
  <article>
    <h2 class="max-w-4xl text-2xl font-semibold leading-tight tracking-[-0.035em] group-hover:underline sm:text-4xl">
      {title}
    </h2>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="프로젝트 핵심 정보">
      {badges.map((badge, index) => (
        <li class:list={[
          'inline-flex min-h-7 items-center rounded-md border px-2.5 py-1 text-xs font-medium leading-none',
          index === 0
            ? 'border-[#b9d2c7] bg-[#edf6f2] text-[#315c4c]'
            : 'border-[var(--line)] bg-[var(--surface)] text-[var(--ink-secondary)]'
        ]}>
          {badge}
        </li>
      ))}
    </ul>
  </article>
</a>
